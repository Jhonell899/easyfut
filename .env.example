# Copia este archivo a .env.local y completa con los datos de tu proyecto
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Pon 1 cuando el código automático por WhatsApp (Meta, migración 007) esté configurado
NEXT_PUBLIC_VERIFICACION_AUTOMATICA=0

# SOLO para probar en tu computadora (npm run dev en localhost): 1 = los dispositivos
# nuevos no piden el enlace del correo, así no se gastan correos. Publicado no tiene efecto.
# EASYFUT_SIN_CORREO_DISPOSITIVO=1
